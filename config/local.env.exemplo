# Copie para ~/.config/jarvis/local.env e preencha. Esse arquivo não vai para o repositório.
# Sem ele, o Jarvis funciona; só o painel do GitLab e o "abre o GitLab" ficam desligados.

# GitLab do trabalho (painel das 7h, "atualiza o GitLab", avisos de MR)
GITLAB_URL=https://gitlab.exemplo.com
GITLAB_USER=seu.usuario
GITLAB_PROJECT_ID=123
GITLAB_REVIEWERS_BOT=project_123_bot_xxxxxxxx
GITLAB_MRS_URL=https://gitlab.exemplo.com/grupo/projeto/-/merge_requests

# Quem o Jarvis atende (entra no começo das instruções do Claude)
JARVIS_SOBRE=Fulano, dev no time X

{
  "manifest_version": 3,
  "name": "Jarvis Música",
  "version": "1.1",
  "description": "Deixa o Jarvis (assistente de voz local) controlar o YouTube Music e ler a página aberta quando você pede.",
  "key": "",
  "background": {
    "service_worker": "fundo.js"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "http://*/*",
    "https://*/*"
  ]
}